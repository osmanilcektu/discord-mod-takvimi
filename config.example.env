# Discord kimlik bilgileri
DISCORD_TOKEN=your_bot_token_here
GUILD_ID=123456789012345678

# Kanallar
ADMIN_MOD_CHANNEL_ID=123456789012345678
LOG_CHANNEL_ID=123456789012345678
SCHEDULE_CHANNEL_ID=123456789012345678
MOD_SCHEDULE_CHANNEL_ID=123456789012345678

# Moderatör rolleri (virgülle ayırın)
MOD_ROLES=MOD,SR MOD,HEAD MOD

# Otomatik günlük planlama (ilk kurulumda güvenli varsayılan: kapalı)
AUTO_SCHEDULE_ENABLED=false
DAILY_SCHEDULE_HOUR=8
SURVEY_TIMEOUT_HOURS=5
TIMEZONE=Europe/Istanbul

# Manuel haftalık anket için yanıt süresi
RESPONSE_TIMEOUT_HOURS=24

# Planlama cezası süreleri
FIRST_VIOLATION_DAYS=2
SECOND_VIOLATION_HOURS=1
THIRD_VIOLATION_DAYS=1

# Sistem tam 5 vardiya bekler
TIME_SLOTS=["00:00-05:00","05:00-10:00","10:00-15:00","15:00-20:00","20:00-24:00"]

# Veritabanı ve log
DATABASE_PATH=./data/bot.db
LOG_LEVEL=info

# Proje izleme / güncelleme bildirimi
GITHUB_REPOSITORY=osmanilcektu/discord-mod-takvimi
UPDATE_CHECK_ENABLED=true
UPDATE_CHECK_INTERVAL_HOURS=6
# Boş bırakılırsa LOG_CHANNEL_ID / ADMIN_MOD_CHANNEL_ID kullanılır
UPDATE_CHANNEL_ID=

# Operasyon raporları (aynı Discord sunucusundaki seçilen kanala; merkezi telemetri değildir)
REPORTING_ENABLED=false
STARTUP_REPORT_ENABLED=false
DAILY_REPORT_ENABLED=false
DAILY_REPORT_HOUR=9
# Boş bırakılırsa LOG_CHANNEL_ID / ADMIN_MOD_CHANNEL_ID kullanılır
REPORT_CHANNEL_ID=
